# ==============================================================================
# Shunno Academy Backend Server Environment Variables (.env.example)
# ==============================================================================

# 1. APPLICATION & SERVER ENVIRONMENT
NODE_ENV=production
PORT=5000

# 2. DATABASE CONFIGURATION (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 3. REDIS & CACHING CONFIGURATION (Optional / Upstash / Local)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false
CACHE_TTL=3600

# 4. JWT & AUTHENTICATION SECRETS
JWT_ACCESS_SECRET="your-jwt-access-secret-key-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-at-least-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"
SALT_ROUNDS=12

# 5. INITIAL SUPER ADMIN ACCOUNT (Auto-seeded on first launch)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@shunnoacademy.com"
SUPER_ADMIN_PASSWORD="YourStrongPassword123!"
SUPER_ADMIN_PHONE="01700000000"

# 6. CLOUDINARY MEDIA ASSET STORAGE
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="shunno-academy"

# 7. FRONTEND CLIENT INTEGRATION
CLIENT_URL="https://shunnoacademy.com"

# 8. SMTP & NODEMAILER EMAIL CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Shunno Academy"
SMTP_FROM_EMAIL="shunnoacademy0@gmail.com"
RESEND_API_KEY="" # Recommended for Render.com Free Tier (HTTPS Port 443)

# 9. GOOGLE OAUTH CONFIGURATION
GOOGLE_CLIENT_ID=""

# 10. CLOUDFLARE TURNSTILE BOT PROTECTION
TURNSTILE_SECRET_KEY=""

# 11. HOSTING & KEEP-ALIVE CONFIGURATION
HOST_ON="render" # Set to 'render' to enable auto-ping cron every 14 min
SERVER_URL=""    # Your Render backend URL (e.g. https://shunno-academy-server.onrender.com)
